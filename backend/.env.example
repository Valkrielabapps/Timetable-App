# Copy this file to .env and adjust as needed.
# For a free hosted Postgres instead of a local one, use your Supabase
# project's connection string instead (Project Settings > Database >
# Connection string > URI). See docs/DEPLOYMENT.md for the full setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timetable
CORS_ORIGINS=http://localhost:5173
DEBUG=true

# Signs login tokens. The default in app/core/config.py is NOT secret —
# set a long random string here before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string

# Used by app/services/llm_constraint_parser.py to parse free-text
# constraints with Claude instead of the regex fallback in
# app/services/constraint_parser.py. Get a key at console.anthropic.com.
# If left blank, constraint parsing silently uses the regex fallback —
# the app still works, just with less flexible phrasing recognition.
ANTHROPIC_API_KEY=

# Google Cloud OAuth 2.0 Client ID (Web application type) — must match
# VITE_GOOGLE_CLIENT_ID in frontend/.env exactly, since the backend
# verifies incoming Google sign-in tokens were issued for this specific
# client. See docs/DEPLOYMENT.md for how to create one. If left blank,
# the "Sign in with Google" button hides itself on the frontend and the
# backend rejects any Google sign-in attempt with a clear error.
GOOGLE_CLIENT_ID=

# Used by app/services/email_service.py to send invite emails via Resend
# (resend.com — free tier is 3,000 emails/month, no credit card needed).
# Get a key at resend.com/api-keys. If left blank, invites are still
# created and the link is still returned to the admin to copy/send
# manually — no email actually goes out.
RESEND_API_KEY=
# Must be "Name <email>" format. The default (onboarding@resend.dev) works
# with no setup but is best for testing only — verify your own domain in
# Resend and set this to your own address before relying on this for real
# users, since unverified-domain mail is more likely to land in spam.
EMAIL_FROM_ADDRESS=Timetable App <onboarding@resend.dev>
# Your deployed frontend's URL (no trailing slash) — used to build the
# invite link inside the email, and the password-reset link (see
# PASSWORD_RESET_EXPIRE_MINUTES below). MUST be set to your real Vercel
# URL in production, or these emails will link to localhost.
FRONTEND_BASE_URL=http://localhost:5173

# How long a forgot-password link stays valid, in minutes, before
# /api/auth/reset-password rejects it as expired. Defaults to 60 if unset.
PASSWORD_RESET_EXPIRE_MINUTES=60

# Sentry DSN for error tracking (https://sentry.io - create a FastAPI/Python
# project to get one). Leave blank to disable Sentry entirely, which is the
# normal state for local development: nothing is reported and no network
# calls are made. See app/core/observability.py.
SENTRY_DSN=
# Tags events so production errors are distinguishable from anything a
# developer machine reports. Railway sets this to "production".
SENTRY_ENVIRONMENT=development

# Set to false to disable all rate limiting (app/core/rate_limit.py). On by
# default; the test suite turns it off. Useful as an escape hatch if a limit
# turns out to be too low for a real school.
RATE_LIMIT_ENABLED=true
