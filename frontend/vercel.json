{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://timetable-app-production-f6bb.up.railway.app/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/why-timetablz",
      "destination": "/why-timetablz/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/customers",
      "destination": "/customers/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/refunds",
      "destination": "/refunds/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "why"
        }
      ],
      "destination": "/why-timetablz",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "pricing"
        }
      ],
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "customers"
        }
      ],
      "destination": "/customers",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "about"
        }
      ],
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "support"
        }
      ],
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "contact"
        }
      ],
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "privacy"
        }
      ],
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "terms"
        }
      ],
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "page",
          "value": "refunds"
        }
      ],
      "destination": "/refunds",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
