# Build settings for the live site. Everything here is compiled into the
# JavaScript every visitor downloads, so it must be public by design.
# NEVER put a secret here (API keys, client secrets, database URLs): those
# belong in backend/.env and Railway's variables, read only by the server.
# src/noSecrets.test.js fails if a VITE_ name looks like a secret.

# Google's OAuth client ID is public: it is shown in every sign-in popup.
VITE_GOOGLE_CLIENT_ID=279654108028-2vcv0gec8p7mavm55ql2tk0srf0aisva.apps.googleusercontent.com
