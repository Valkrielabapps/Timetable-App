# Copy this file to .env and adjust as needed. Vite only exposes vars
# prefixed VITE_ to browser code — see https://vitejs.dev/guide/env-and-mode.

# Google Cloud OAuth 2.0 Client ID (Web application type) — must match
# GOOGLE_CLIENT_ID in backend/.env exactly. See docs/DEPLOYMENT.md for
# how to create one. If left blank, the "Continue with Google" button on
# AuthPage.jsx simply doesn't render (email/password still works fine).
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN for browser error tracking (https://sentry.io - create a React
# project to get one; it is a *different* DSN from the backend's SENTRY_DSN).
# Leave blank to disable Sentry entirely, which is the normal state for local
# development. See src/observability.js.
VITE_SENTRY_DSN=
